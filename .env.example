# Sabor Express — variáveis de ambiente (copie para .env do seu provedor; NUNCA commite segredos)
NODE_ENV=production
PORT=3000
APP_URL=https://seu-dominio.com.br

# OBRIGATÓRIO em produção: string aleatória de 32+ caracteres (ex.: openssl rand -hex 32)
JWT_SECRET=

# Primeiro administrador (criado só se ainda não existir admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Diretório do banco SQLite e dos uploads — precisa ser um DISCO PERSISTENTE com backup
DATA_DIR=/data

# Atrás de proxy/CDN com HTTPS (Render, Fly, Nginx...): confie no X-Forwarded-For para o rate-limit
TRUST_PROXY=true
COOKIE_SECURE=true

# Geocodificação (converte endereço em coordenadas para a regra de 15 km)
# 'nominatim' = OpenStreetMap público (1 req/s; só para volume baixo). 'none' desativa.
GEOCODER_PROVIDER=nominatim
GEOCODER_CONTACT=seu-email-de-contato@seu-dominio.com.br
# Em produção com geocodificador confiável, recomenda-se false (veja docs/DECISOES.md, risco R1)
ALLOW_DEVICE_COORDS=true

# Pagamento online (opcional): segredo HMAC compartilhado com o gateway que chamará /api/payments/webhook
PAYMENT_WEBHOOK_SECRET=

# E-mail transacional (recuperação de senha): URL de webhook que aceite POST JSON {from,to,subject,text}
MAIL_WEBHOOK_URL=
MAIL_FROM=Sabor Express <nao-responda@seu-dominio.com.br>
